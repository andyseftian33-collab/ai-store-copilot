{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threads-1k-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "vars": {
    "THREADS_APP_ID": "SET_IN_CLOUDFLARE_DASHBOARD"
  },
  "secrets": {
    "required": ["THREADS_APP_SECRET", "DASHBOARD_SECRET", "TOKEN_ENCRYPTION_KEY"]
  }
}
